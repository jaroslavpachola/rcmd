# StartupNotify is false on purpose: eframe never reads the Wayland
# activation token gnome-shell passes in $XDG_ACTIVATION_TOKEN, so a
# promised startup sequence never completes and mutter's 'smart' focus
# leaves the new window behind whatever had focus at the time.
[Desktop Entry]
Type=Application
Version=1.0
Name=rcmd
GenericName=File Manager
Comment=rcmd in a window: the egui front end
Exec=rcmd-egui
TryExec=rcmd-egui
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
Keywords=file;manager;commander;orthodox;panels;mc;
StartupNotify=false
StartupWMClass=rcmd-egui
